{
    "version": 8,
    "configurePresets": [
        {
            "name": "9800X3D-Clang-Ninja",
            "displayName": "Clang 19 (Ninja) - Zen 5 Optimized",
            "description": "High-performance build using clang-cl and Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_CXX_FLAGS": "/clang:-march=znver5",
                "CMAKE_C_FLAGS": "/clang:-march=znver5",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Release",
            "configurePreset": "9800X3D-Clang-Ninja",
            "configuration": "Release"
        }
    ]
}
